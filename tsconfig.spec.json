/* Tests run directly in Node (`npm test`), which strips the types without checking them. This config is for checking them. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.spec.ts"
  ]
}
